# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Transport mode: webhook (recommended) or polling (local development)
BOT_MODE=webhook
# Optional: drop queued Telegram updates on polling startup (default: false)
DROP_PENDING_UPDATES=false
# Secret for webhook endpoints (required if BOT_MODE=webhook)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: Honeybadger project API key for error reporting
HONEYBADGER_API_KEY=
# Optional: Honeybadger environment name (defaults to RAILWAY_ENVIRONMENT or development)
HONEYBADGER_ENVIRONMENT=

# Optional comma-separated allowlist for private deployments, e.g. 123456789,-100987654321
ALLOWED_CHAT_IDS=
# Optional comma-separated Telegram user IDs allowed to run /admin stats
ADMIN_USER_IDS=

# Log format: json | text (defaults to json when RAILWAY_ENVIRONMENT is set)
LOG_FORMAT=
