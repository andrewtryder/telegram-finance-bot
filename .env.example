TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Honeybadger project API key for error reporting
HONEYBADGER_API_KEY=
# Optional: Honeybadger environment name (defaults to RAILWAY_ENVIRONMENT or development)
HONEYBADGER_ENVIRONMENT=
# Optional comma-separated allowlist for private deployments, e.g. 123456789,-100987654321
ALLOWED_CHAT_IDS=
# SQLite path for watchlists/alerts (mount a Railway volume here in production)
DATA_DIR=./data
# Log format: json | text (defaults to json when RAILWAY_ENVIRONMENT is set)
LOG_FORMAT=
